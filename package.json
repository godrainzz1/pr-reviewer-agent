{
  "name": "pr-reviewer-agent",
  "version": "1.0.0",
  "description": "GitHub Action that reviews PR diffs using LLM and posts review comments",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map",
    "start": "node dist/index.js",
    "dev": "ncc build src/index.ts -o dist --source-map && node dist/index.js"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "openai": "^6.39.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vercel/ncc": "^0.38.4",
    "typescript": "^6.0.3"
  }
}
